    },
    "/api/v1/dashboard/summary": {
      "get": {
        "tags": [
          "Dashboard"
        ],
        "summary": "High-level KPI and timeliness metrics summary",
        "description": "Returns total volume, dual timely response rates, in-progress counts, and coverage.",
        "operationId": "get_dashboard_summary_api_v1_dashboard_summary_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardSummaryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analytics/categories": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Category and sub-category volume and timely response rates (alias)",
        "description": "Returns volume, share, and timeliness breakdown for categories or sub-categories.",
        "operationId": "get_by_category_api_v1_analytics_categories_get",
        "parameters": [
          {
            "name": "group_by",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "category",
                "sub_category"
              ],
              "type": "string",
              "description": "Aggregation level: category or sub_category",
              "default": "category",
              "title": "Group By"
            },
            "description": "Aggregation level: category or sub_category"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "total",
                "timely_rate",
                "name"
              ],
              "type": "string",
              "description": "Sort field: total, timely_rate, or name",
              "default": "total",
              "title": "Sort"
            },
            "description": "Sort field: total, timely_rate, or name"
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string",
              "description": "Sort direction: asc or desc",
              "default": "desc",
              "title": "Order"
            },
            "description": "Sort direction: asc or desc"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ByCategoryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
