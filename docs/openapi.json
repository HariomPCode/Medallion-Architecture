{
  "openapi": "3.1.0",
  "info": {
    "title": "Finance Complaints Medallion API",
    "description": "Grounded AI & Analytics API for CFPB Financial Consumer Complaints",
    "version": "1.0.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Process liveness check",
        "description": "Returns 200 if the process is running and accepting HTTP connections.",
        "operationId": "health_live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Live Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Data readiness check",
        "description": "Returns 200 if a validated snapshot is loaded in memory.\nReturns 503 if data is unavailable or failing validation.",
        "operationId": "health_ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Ready Health Ready Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meta/dataset": {
      "get": {
        "tags": [
          "Metadata"
        ],
        "summary": "Dataset provenance and health metadata",
        "description": "Returns dataset provenance, status, row counts, and refresh timestamps.",
        "operationId": "get_dataset_metadata_api_v1_meta_dataset_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetMetaResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meta/filters": {
      "get": {
        "tags": [
          "Metadata"
        ],
        "summary": "Available filter dimensions and values",
        "description": "Returns available dimensions, valid values, and hierarchy mappings for filtering.",
        "operationId": "get_filters_metadata_api_v1_meta_filters_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FiltersMetaResponse"
                }
              }
            }
          }
        }
