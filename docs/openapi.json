    "/api/v1/analytics/trends": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Time-series complaint trends with partial-period flags and YoY growth",
        "description": "Returns time-series volume trends, data-driven partial period flags, and YoY growth.",
        "operationId": "get_trends_api_v1_analytics_trends_get",
        "parameters": [
          {
            "name": "grain",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "year",
                "month"
              ],
              "type": "string",
              "description": "Time granularity: year or month",
              "default": "year",
              "title": "Grain"
            },
            "description": "Time granularity: year or month"
          },
          {
            "name": "group_by",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "none",
                "category"
              ],
              "type": "string",
              "description": "Series breakdown: none or category",
              "default": "none",
              "title": "Group By"
            },
            "description": "Series breakdown: none or category"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrendsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analytics/breakdown": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Top-N distribution breakdown by dimension",
        "description": "Returns top-N categories along the selected dimension with an 'Other' remainder bucket.",
        "operationId": "get_breakdown_api_v1_analytics_breakdown_get",
        "parameters": [
          {
            "name": "dimension",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "submitted_via",
                "state",
                "company_response",
                "issue",
                "product"
              ],
              "type": "string",
              "description": "Target dimension to group and rank",
              "title": "Dimension"
            },
            "description": "Target dimension to group and rank"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "description": "Max top items (1-50)",
              "default": 10,
              "title": "Limit"
            },
            "description": "Max top items (1-50)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BreakdownResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analytics/kpis": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "High-level KPI metrics summary",
        "description": "Calculates KPI summary indicators (total, timely rates, in-progress, coverage).",
        "operationId": "get_kpis_api_v1_analytics_kpis_get",
        "responses": {
          "200": {
            "description": "Successful Response",
