              "type": "string",
              "description": "Sort field: total, timely_rate, or name",
              "default": "total",
              "title": "Sort"
            },
            "description": "Sort field: total, timely_rate, or name"
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string",
              "description": "Sort direction: asc or desc",
              "default": "desc",
              "title": "Order"
            },
            "description": "Sort direction: asc or desc"
          }
