# ==============================================================================
# Finance Complaints Medallion - Frontend Environment Variables Example
# Copy to .env.local for local development. Never commit real secrets.
# ==============================================================================

# Backend API Base URL
# Used strictly by Next.js BFF server-side proxy route handlers.
# Never prefix with NEXT_PUBLIC_ to prevent browser bundle leakage.
BACKEND_BASE_URL=http://localhost:8000

# Shared internal API key for server-to-server calls from Next.js BFF proxy to FastAPI backend.
# Never prefix with NEXT_PUBLIC_ to prevent browser bundle leakage.
# Leave blank for local development when backend is running without internal key enforcement.
INTERNAL_API_KEY=

# Public application display name (safe for browser exposure)
NEXT_PUBLIC_APP_NAME="Finance Complaints Medallion"
