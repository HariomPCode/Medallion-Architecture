# ==============================================================================
# Finance Complaints Medallion — Backend Environment Configuration
# ==============================================================================
# Copy this file to 'backend/.env' for local configuration.
# NEVER commit the actual '.env' file or any real secrets to version control.
# Reference: docs/FINANCE_COMPLAINTS_DEVELOPMENT_PLAN.md §12.4
# ==============================================================================

# Application Environment: local | test | production
# In production, strict validation is enforced (CORS wildcard rejected, API key required, etc.)
APP_ENV=local

# Data Source Mode: fixture | local_snapshot | azure
# - fixture: loads small hand-verified test dataset from tests/fixtures/tiny
# - local_snapshot: loads full dataset rebuilt locally in backend/.local_data
# - azure: downloads production Medallion outputs directly from ADLS Gen2
DATA_MODE=fixture
LOCAL_DATA_DIR=.local_data

# Azure Data Lake Storage Gen2 Configuration
AZURE_STORAGE_ACCOUNT_NAME=financecomplaintssa
AZURE_AUTH_MODE=default_credential
AZURE_STORAGE_CONNECTION_STRING=
AZURE_SILVER_CONTAINER=silver
AZURE_GOLD_CONTAINER=gold
SILVER_COMPLAINTS_BLOB=ConsumerComplaints_Silver.csv
SILVER_PRODUCTS_BLOB=ProductCategoryReference_Silver.csv
GOLD_CATEGORY_BLOB=complaints_by_category_gold.csv
GOLD_TREND_BLOB=complaints_trend_gold.csv
GOLD_ANOMALY_BLOB=complaints_anomaly_gold.csv
GOLD_DQ_REPORT_BLOB=data_quality_report_gold.csv
GOLD_DQ_RUN_BLOB=data_quality_run_gold.csv

# Data Ingestion & Refresh Controls
DATA_REFRESH_CHECK_SECONDS=300
DATA_MAX_SKEW_HOURS=24
MAX_BLOB_BYTES=104857600

# Security, CORS & Network Safeguards
# INTERNAL_API_KEY is required in production; optional in local dev
INTERNAL_API_KEY=
CORS_ALLOW_ORIGINS=http://localhost:3000
MAX_REQUEST_BYTES=65536
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_EXPORT=10/hour
RATE_LIMIT_AI=10/minute
EXPORT_MAX_ROWS=10000

# Structured Logging
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_AI_PROMPTS=false

# AI Assistant & Azure OpenAI / Foundry
# In local/test mode, LLM_PROVIDER can be 'disabled' or 'fake'
LLM_PROVIDER=disabled
LLM_ENDPOINT=
LLM_DEPLOYMENT=
LLM_API_VERSION=2024-02-15-preview
LLM_AUTH_MODE=api_key
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=700
AI_MAX_TOOL_CALLS=3
AI_HISTORY_MAX_MESSAGES=6
AI_MAX_QUESTION_CHARS=500
AI_DAILY_REQUEST_CAP=300
