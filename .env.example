# ==============================================================================
# Finance Complaints Medallion — Root Environment Template
# ==============================================================================
# This repository is a monorepo consisting of:
#   - Backend: FastAPI modular monolith (see backend/.env.example)
#   - Frontend: Next.js application (see frontend/.env.example)
#
# NOTE: Real environment variables, secrets, keys, and connection strings must
# NEVER be committed to Git. Create local '.env' files in the respective
# subdirectories and ensure they remain git-ignored.
#
# Authoritative environment variable reference: docs/FINANCE_COMPLAINTS_DEVELOPMENT_PLAN.md §12.4
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env.example)
# ------------------------------------------------------------------------------
# Application Environment: local | test | production
APP_ENV=local

# Data Mode: fixture | local_snapshot | azure
DATA_MODE=fixture
LOCAL_DATA_DIR=.local_data

# Azure Data Lake Storage Gen2 (Read-only data source)
AZURE_STORAGE_ACCOUNT_NAME=financecomplaintssa
AZURE_AUTH_MODE=default_credential
AZURE_STORAGE_CONNECTION_STRING=
AZURE_SILVER_CONTAINER=silver
AZURE_GOLD_CONTAINER=gold
SILVER_COMPLAINTS_BLOB=ConsumerComplaints_Silver.csv
SILVER_PRODUCTS_BLOB=ProductCategoryReference_Silver.csv
GOLD_CATEGORY_BLOB=complaints_by_category_gold.csv
GOLD_TREND_BLOB=complaints_trend_gold.csv
GOLD_ANOMALY_BLOB=complaints_anomaly_gold.csv
GOLD_DQ_REPORT_BLOB=data_quality_report_gold.csv
GOLD_DQ_RUN_BLOB=data_quality_run_gold.csv

# Data Polling and Ingestion Controls
DATA_REFRESH_CHECK_SECONDS=300
DATA_MAX_SKEW_HOURS=24
MAX_BLOB_BYTES=104857600

# Backend Security and API Access
INTERNAL_API_KEY=
CORS_ALLOW_ORIGINS=http://localhost:3000
MAX_REQUEST_BYTES=65536
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_EXPORT=10/hour
RATE_LIMIT_AI=10/minute
EXPORT_MAX_ROWS=10000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_AI_PROMPTS=false

# AI Assistant and LLM Configuration (Azure AI Foundry / Azure OpenAI)
LLM_PROVIDER=disabled
LLM_ENDPOINT=
LLM_DEPLOYMENT=
LLM_API_VERSION=2024-02-15-preview
LLM_AUTH_MODE=api_key
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=700
AI_MAX_TOOL_CALLS=3
AI_HISTORY_MAX_MESSAGES=6
AI_MAX_QUESTION_CHARS=500
AI_DAILY_REQUEST_CAP=300

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env.example)
# ------------------------------------------------------------------------------
BACKEND_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Complaint Intelligence
